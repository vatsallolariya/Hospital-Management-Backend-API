# PostgreSQL (used by both docker-compose and Django settings)
POSTGRES_DB=hospital_api
POSTGRES_USER=hospital_api
POSTGRES_PASSWORD=hospital_api
POSTGRES_HOST=localhost
# Docker Compose publishes the container's 5432 on host 5433 to avoid clashing
# with a locally installed PostgreSQL. Use 5432 if you connect to a local instance.
POSTGRES_PORT=5433

# Django
DJANGO_SECRET_KEY=change-me-in-prod
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Used by `manage.py seed_superadmin` (optional — can also pass --email/--password)
SUPERADMIN_EMAIL=admin@gmail.com
SUPERADMIN_PASSWORD=admin123
